{
  "name": "repoview",
  "private": true,
  "version": "1.3.8",
  "description": "Go from first import to safe code changes faster: onboard into unfamiliar repos, get grounded answers from your files, apply edits with review, and run tests without leaving one workspace.",
  "author": "Misterscan",
  "license": "MIT",
  "keywords": [
    "repository documentation",
    "code review",
    "AI assistant",
    "developer tools",
    "software development"
  ],
  "type": "module",
  "scripts": {
    "dev": "dotenvx run --overload -- tsx server/index.ts --dev",
    "build": "vite build",
    "preview": "dotenvx run -- tsx server/index.ts",
    "start": "dotenvx run --overload -- tsx server/index.ts",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "lint": "eslint . && tsc --noEmit",
    "lint:eslint": "eslint .",
    "lint:types": "tsc --noEmit",
    "test:models": "node --import tsx --test tests/models.test.ts",
    "logs:summarize": "tsx scripts/summarize-logs.ts"
  },
  "dependencies": {
    "@dotenvx/dotenvx-ops": "0.56.1",
    "@google/genai": "2.32.0",
    "@tailwindcss/typography": "^0.5.4",
    "@tailwindcss/vite": "^4.3.4",
    "@types/ws": "^8.18.2",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "adm-zip": "0.6.1",
    "clsx": "^2.1.1",
    "dotenv": "18.0.9",
    "dotenvx-ops": "^0.0.1",
    "express": "5.3.0",
    "express-rate-limit": "8.7.3",
    "idb": "^8.0.4",
    "jszip": "^3.10.2",
    "lucide-react": "1.69.0",
    "motion": "14.9.1",
    "multer": "2.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "tailwind-merge": "3.7.0",
    "ws": "8.22.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@repoview/lint-toolchain": "file:tools/lint-toolchain",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "autoprefixer": "^10.6.2",
    "eslint": "10.14.0",
    "globals": "^17.14.0",
    "tailwindcss": "4.3.4",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "^8.3.6"
  },
  "overrides": {
    "ts-api-utils": {
      "typescript": "6.0.3"
    },
    "eslint": {
      "minimatch": "11.0.4"
    },
    "@eslint/config-array": {
      "minimatch": "11.0.4"
    },
    "@repoview/lint-toolchain": {
      "minimatch": "11.0.4"
    },
    "@tailwindcss/typography": {
      "postcss-selector-parser": "6.1.5"
    }
  },
  "allowScripts": {
    "@google/genai@2.32.0": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "protobufjs@7.6.6": true
  }
}
