{
  "name": "repoview",
  "private": true,
  "version": "1.3.7",
  "description": "Go from first import to safe code changes faster: onboard into unfamiliar repos, get grounded answers from your files, apply edits with review, and run tests without leaving one workspace.",
  "author": "Misterscan",
  "license": "MIT",
  "keywords": [
    "repository documentation",
    "code review",
    "AI assistant",
    "developer tools",
    "software development"
  ],
  "type": "module",
  "scripts": {
    "dev": "dotenvx run --overload -- tsx server/index.ts --dev",
    "build": "vite build",
    "preview": "dotenvx run -- tsx server/index.ts",
    "start": "dotenvx run --overload -- tsx server/index.ts",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "lint": "eslint . && tsc --noEmit",
    "lint:eslint": "eslint .",
    "lint:types": "tsc --noEmit",
    "logs:summarize": "tsx scripts/summarize-logs.ts"
  },
  "dependencies": {
    "@dotenvx/dotenvx-ops": "0.55.1",
    "@google/genai": "2.8.0",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "^4.3.1",
    "@types/ws": "^8.18.1",
    "adm-zip": "0.5.17",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "dotenvx-ops": "^0.0.1",
    "express": "5.2.1",
    "express-rate-limit": "8.5.2",
    "idb": "^8.0.3",
    "jszip": "^3.10.1",
    "lucide-react": "1.18.0",
    "motion": "12.40.0",
    "multer": "2.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "tailwind-merge": "^3.6.0",
    "ws": "^8.21.0",
    "@xterm/xterm": "6.0.0",
    "@xterm/addon-fit": "0.11.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/adm-zip": "^0.5.8",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.5.0",
    "eslint": "10.5.0",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.4.0",
    "tailwindcss": "4.3.1",
    "tsx": "4.22.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.61.1",
    "vite": "8.0.16"
  },
  "allowScripts": {
    "@google/genai@2.8.0": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "fsevents@2.3.2": true,
    "protobufjs@7.6.4": true
  }
}
